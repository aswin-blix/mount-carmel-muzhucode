# Public URL of the deployed site (used for canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Where admission enquiries are delivered. The form POSTs validated JSON here:
# {parentName, phone, childName, classApplying, message, receivedAt, source}
# Works with a Google Apps Script web app, Zapier, Make, n8n or any endpoint that accepts JSON.
# Leave empty and the form asks parents to phone the office instead.
ENQUIRY_WEBHOOK_URL=
